# Copy to .env for local development: cp .env.example .env
# All values below are local development defaults, never production secrets.

# HTTP port the server listens on.
PORT=8080

# PostgreSQL password of the local Compose database (used by compose.yaml).
POSTGRES_PASSWORD=undercover-dev
# Host port of the local database (5433 avoids clashing with another local PostgreSQL).
DB_PORT=5433

# PostgreSQL connection string used by `make dev`, `make migrate` and `make test`.
# In Compose (`make up`), the app container overrides it to reach the `db` service.
DATABASE_URL=postgres://undercover:undercover-dev@localhost:5433/undercover?sslmode=disable

# Secret salt used to hash IP addresses before storing reports (required).
# Production: a long random value, e.g. `openssl rand -hex 32`, stored with SOPS.
IP_HASH_SALT=dev-only-salt

# Trust the X-Forwarded-For header to find the client IP. Only enable it behind a
# proxy that sets this header (Traefik in production); keep false locally.
TRUST_PROXY=false

# Maximum requests per IP and per hour.
RATE_LIMIT_SUGGESTIONS=20
RATE_LIMIT_REPORTS=30
RATE_LIMIT_CHECKS=300
