# Copy to .env for local development: cp .env.example .env
# All values below are local development defaults, never production secrets.

# HTTP port the server listens on.
PORT=8080

# PostgreSQL password of the local Compose database (used by compose.yaml).
POSTGRES_PASSWORD=home-dev
# Host port of the local database (5436: Undercover, Pastebin and Linktree use 5433 to 5435).
DB_PORT=5436

# PostgreSQL connection string used by `make dev`, `make migrate` and `make test`.
# In Compose (`make up`), the app container overrides it to reach the `db` service.
DATABASE_URL=postgres://home:home-dev@localhost:5436/home?sslmode=disable

# bcrypt hash of the admin password (required). Generate one with `make hash-password`.
# Keep the single quotes: without them, Compose and make read the "$" of the hash
# as variables. This one is the hash of "home-dev-password", for local use only.
ADMIN_PASSWORD_HASH='$2a$12$vBqGALXSXAKWkfA9xumGqeKtVeo8udjWiULOC3ZO44MikaeUaXN7u'

# Public URL of the site: absolute Open Graph URLs, Origin check of the admin, and
# HTTPS cookies when it starts with https:// (always in production).
PUBLIC_BASE_URL=http://localhost:8080

# Trust the X-Forwarded-For header to find the client IP. Only enable it behind a
# proxy that sets this header (Traefik in production); keep false locally.
TRUST_PROXY=false

# Login attempts allowed per IP and per hour.
RATE_LIMIT_LOGIN=10

# Largest accepted banner upload, in megabytes.
MAX_UPLOAD_MB=5
