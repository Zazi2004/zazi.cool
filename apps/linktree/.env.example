# Copy to .env for local development: cp .env.example .env
# All values below are local development defaults, never production secrets.

# HTTP port the server listens on.
PORT=8080

# PostgreSQL password of the local Compose database (used by compose.yaml).
POSTGRES_PASSWORD=linktree-dev
# Host port of the local database (5435: Undercover and Pastebin use 5433 and 5434).
DB_PORT=5435

# PostgreSQL connection string used by `make dev`, `make migrate` and `make test`.
# In Compose (`make up`), the app container overrides it to reach the `db` service.
DATABASE_URL=postgres://linktree:linktree-dev@localhost:5435/linktree?sslmode=disable

# bcrypt hash of the admin password (required). Generate one with `make hash-password`.
# Keep the single quotes: without them, Compose and make read the "$" of the hash
# as variables. This one is the hash of "linktree-dev", for local use only.
ADMIN_PASSWORD_HASH='$2a$12$ZKJ.qFNjuSbuGfVEqweUquDOs/DHOyZ3YuKwSRku9j.OruhRwHWhi'

# Public URL of the site: absolute Open Graph URLs, and HTTPS cookies when it starts
# with https:// (always in production).
PUBLIC_BASE_URL=http://localhost:8080

# Trust the X-Forwarded-For header to find the client IP. Only enable it behind a
# proxy that sets this header (Traefik in production); keep false locally.
TRUST_PROXY=false

# Login attempts allowed per IP and per hour.
RATE_LIMIT_LOGIN=10

# Largest accepted image upload, in megabytes.
MAX_UPLOAD_MB=5

# Vite dev server: when set, pages load the front from it, with hot reload.
# `make dev` sets it to http://localhost:5173; leave it empty otherwise.
VITE_DEV_URL=
