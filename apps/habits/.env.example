# Copy to .env for local development: cp .env.example .env
# All values below are local development defaults, never production secrets.

# HTTP port the server listens on.
PORT=8080

# PostgreSQL password of the local Compose database (used by compose.yaml).
POSTGRES_PASSWORD=habits-dev
# Host port of the local database (5437: the other apps use 5433 to 5436).
DB_PORT=5437

# PostgreSQL connection string used by `make dev`, `make migrate` and `make test`.
# In Compose (`make up`), the app container overrides it to reach the `db` service.
DATABASE_URL=postgres://habits:habits-dev@localhost:5437/habits?sslmode=disable

# bcrypt hash of the password (required). Generate one with `make hash-password`.
# Keep the single quotes: without them, Compose and make read the "$" of the hash
# as variables. This one is the hash of "habits-dev-password", for local use only.
ADMIN_PASSWORD_HASH='$2a$12$cAZs8GlgigKeEV7KaIAlS.0Dm9Flh2a2KC98MJRWPpw9ivwJs0f56'

# Public URL of the site: Origin check of the POSTs, and HTTPS cookies and HSTS when it
# starts with https:// (always in production).
BASE_URL=http://localhost:8080

# Take the client IP from X-Forwarded-For (true behind Traefik, false otherwise).
TRUST_PROXY=false

# Login attempts allowed per IP and per hour; beyond that, 429.
RATE_LIMIT_LOGIN=10
