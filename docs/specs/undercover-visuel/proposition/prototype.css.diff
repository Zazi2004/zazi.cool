+
+/* ---- Proposed visual direction: "night aurora" (prototype, ONBO-27) ---- */
+
+/* Aurora: three blurred colour blobs drifting behind the page. Decorative only. */
+body {
+  position: relative;
+  min-height: 100vh;
+}
+
+body::before {
+  content: "";
+  position: fixed;
+  inset: 0;
+  z-index: -1;
+  pointer-events: none;
+  background:
+    radial-gradient(34rem 26rem at 10% 8%, var(--glow-a), transparent 70%),
+    radial-gradient(30rem 24rem at 92% 22%, var(--glow-b), transparent 70%),
+    radial-gradient(30rem 24rem at 45% 100%, var(--glow-c), transparent 70%);
+  opacity: var(--glow-opacity);
+  filter: blur(40px);
+  animation: drift 22s ease-in-out infinite alternate;
 }
+
+.topbar {
+  border-bottom-color: transparent;
+}
+
+.brand {
+  font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
+  text-transform: uppercase;
+  letter-spacing: 0.22em;
+  font-size: 0.85rem;
+}
+
+.hero h1 {
+  font-size: 2.8rem;
+  letter-spacing: -0.02em;
+  background: linear-gradient(120deg, var(--text) 10%, var(--accent) 55%, var(--glow-c) 110%);
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+}
+
+.eyebrow {
+  font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
+  letter-spacing: 0.16em;
+}
+
+.card,
+.secret {
+  box-shadow: 0 8px 30px rgb(0 0 0 / 25%);
+}
+
+.button,
+.choice {
+  transition:
+    transform 0.12s ease,
+    border-color 0.2s ease,
+    background-color 0.2s ease;
+}
+
+.button:active:not(:disabled),
+.choice:active {
+  transform: scale(0.97);
+}
+
+.button.primary {
+  background: linear-gradient(135deg, var(--accent), color-mix(in srgb, var(--accent) 70%, var(--glow-c)));
+  box-shadow: 0 6px 24px color-mix(in srgb, var(--accent) 35%, transparent);
+}
+
+/* The secret looks like a classified file. */
+.secret {
+  position: relative;
+  border: 1px dashed var(--accent);
+  background: linear-gradient(160deg, var(--surface-strong), var(--surface));
+}
+
+.secret::before {
+  content: "CONFIDENTIEL";
+  display: block;
+  margin-bottom: 8px;
+  font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
+  font-size: 0.75rem;
+  letter-spacing: 0.3em;
+  color: var(--danger);
+}
+
+.secret-word {
+  animation: unblur 0.6s ease-out both;
+}
+
+/* Entrance: each block of a screen rises in turn. */
+.stack > * {
+  animation: rise 0.45s ease-out both;
+}
+.stack > :nth-child(2) { animation-delay: 0.06s; }
+.stack > :nth-child(3) { animation-delay: 0.12s; }
+.stack > :nth-child(4) { animation-delay: 0.18s; }
+.stack > :nth-child(n + 5) { animation-delay: 0.24s; }
+
+.order li {
+  animation: rise 0.4s ease-out both;
+}
+.order li:nth-child(2) { animation-delay: 0.1s; }
+.order li:nth-child(3) { animation-delay: 0.2s; }
+.order li:nth-child(4) { animation-delay: 0.3s; }
+.order li:nth-child(n + 5) { animation-delay: 0.4s; }
+
+.choice.selected {
+  background: color-mix(in srgb, var(--danger) 18%, var(--surface-strong));
+}
+
+@keyframes rise {
+  from { opacity: 0; transform: translateY(10px); }
+  to { opacity: 1; transform: none; }
+}
+
+@keyframes drift {
+  to { transform: translate3d(2%, 3%, 0) scale(1.08); }
+}
+
+@keyframes unblur {
+  from { opacity: 0; filter: blur(12px); }
+  to { opacity: 1; filter: none; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after {
+    animation: none !important;
+    transition: none !important;
+  }
+}
